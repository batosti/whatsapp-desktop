{
  "name": "whatsapp-electron",
  "version": "1.0.6",
  "description": "Whatsapp Desktop",
  "desktopName": "whatsapp-electron.desktop",
  "main": "app/index.js",
  "type": "module",
  "author": {
    "name": "André Batosti",
    "email": "batosti@gmail.com",
    "url": "https://github.com/batosti/"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron ./app --no-sandbox",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --linux snap",
    "publish": "electron-builder --linux snap -p always"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0"
  },
  "build": {
    "appId": "whatsapp-electron",
    "files": [
      "app/**/**",
      "build/**/**",
      "node_modules/**/**",
      "package.json"
    ],
    "protocols": {
      "name": "whatsapp",
      "schemes": [
        "whatsapp"
      ]
    },
    "linux": {
      "category": "Chat;Network",
      "packageCategory": "net",
      "executableName": "whatsapp-electron",
      "synopsis": "Whatsapp Desktop",
      "description": "Unofficial Whatsapp client for Linux using Electron and Whatsapp Web",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Whatsapp Desktop"
        }
      },
      "target": [
        "deb",
        "snap"
      ]
    },
    "snapcraft": {
      "base": "core24",
      "publish": [
        {
          "provider": "snapStore"
        }
      ],
      "core24": {
        "summary": "Whatsapp Desktop",
        "grade": "stable",
        "confinement": "strict",
        "useLXD": true,
        "plugs": [
          "default",
          "browser-support",
          "audio-record",
          "camera",
          "screen-inhibit-control"
        ]
      }
    }
  },
  "dependencies": {
    "electron-context-menu": "^5.1.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": false
  },
  "engines": {
    "node": ">=24"
  }
}
